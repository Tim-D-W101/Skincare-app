{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Replaces the base list, so it repeats it. Edge Functions and scripts run
  // on Deno and are checked with `deno check` instead.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions",
    "scripts"
  ]
}
